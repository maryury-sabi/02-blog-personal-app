{
  "name": "02-blog-personal-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --coverage",
    "test:hook": "node --test .claude/hooks/pre-tool-use.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:hook",
    "prepare": "husky"
  },
  "dependencies": {
    "expo": "^58.0.25",
    "expo-clipboard": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-location": "~58.0.22",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sensors": "~58.0.5",
    "expo-sharing": "~58.0.23",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "^58.0.26",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "lint-staged": "^15.4.0",
    "prettier": "^3.5.0",
    "react-test-renderer": "19.3.0",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js,json,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --max-warnings 0 --no-warn-ignored"
    ]
  }
}
